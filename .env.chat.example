# Keys SOLO del chat (y de su memoria). Varias keys por proveedor, separadas por coma.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4.1-mini
# Si tu servicio GPT no es api.openai.com, pon aquí su URL base compatible con OpenAI:
# OPENAI_BASE_URL=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-20b
LLM_ORDER=gemini,openai,groq
MEMORY_LLM_ORDER=groq,openai,gemini
DEBUG_AI=0   # 1 = muestra detalle técnico de errores de IA (solo desarrollo; en producción se ignora)
# Voces naturales (Gemini TTS). Usa las mismas keys de Gemini de arriba. Puedes cambiar/ordenar los modelos:
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# Orden de las voces naturales (Groq no tiene voz en español, por eso no está). Modelos de voz de OpenAI y estilo:
# TTS_ORDER=gemini   (por defecto solo Gemini; para sumar OpenAI como respaldo de voz: gemini,openai)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts,tts-1
# TTS_STYLE=Habla en español colombiano, de forma natural, cálida y cercana, como un amigo que te habla tranquilo
# Opcional, para respuestas más rápidas con modelos Gemini que 'piensan' antes de responder (si tu modelo lo acepta): GEMINI_THINKING_LEVEL=low
