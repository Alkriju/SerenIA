# ───── Copia este archivo a .env y completa los valores. NUNCA subas .env a git ni lo compartas (ya está en .gitignore). ─────
# Secretos nuevos:  python tools/gen_secrets.py
APP_ENV=development                 # production en el servidor público (activa las comprobaciones de seguridad: si algo es inseguro, NO arranca)
BASE_URL=http://localhost:8000      # en producción: https://tu-dominio.com
# ───── Datalake S3 ─────  (Docker local = SeaweedFS; nube = Cloudflare R2: ver .env.vercel.example)
S3_URL=http://seaweed:8333
S3_KEY=serenia
S3_SECRET=cambia-esto               # la misma clave que S3_SECRET de tools/gen_secrets.py (el contenedor seaweed también la lee de aquí)
S3_BUCKET=lake
S3_REGION=us-east-1
MONGO_URL=mongodb://mongo:27017    # con usuario: mongodb://USUARIO:CLAVE@mongo:27017/?authSource=admin  (y define MONGO_ROOT_USER / MONGO_ROOT_PASS abajo)
MONGO_ROOT_USER=
MONGO_ROOT_PASS=
PG_PASS=cambia-esto                 # contraseña de PostgreSQL local (compose la usa para crear la base)
DATABASE_URL=postgresql://serenia:cambia-esto@postgres:5432/serenia   # repite aquí PG_PASS. En la nube: la URL de Neon (ver .env.vercel.example)
JWT_SECRET=                         # 32+ caracteres aleatorios (obligatorio)
PSEUDO_KEY=                         # 32+ caracteres aleatorios, distinta de JWT_SECRET (hashes de correos para consentimientos y borrados; obligatoria en producción)
DEV_AUTH=0                          # 1 = entra sin contraseña (SOLO desarrollo; con APP_ENV=production no arranca)
EMAIL_DOMAIN=*                      # p. ej. uniminuto.edu.co  (en producción no se admite * salvo ALLOW_ANY_EMAIL=1)
ALLOW_ANY_EMAIL=0
ADMIN_EMAILS=                       # correos (coma) que pueden ver /status, /diagnose y /context del chat
TERMS_VERSION=2026-11-16            # debe coincidir con frontend/legal/legal.json; si la cambias, TODOS deben volver a aceptar
SESSION_HOURS=168
COOKIE_SECURE=0                     # en producción se fuerza a 1
MS_TENANT=
MS_CLIENT_ID=
MS_SECRET=
# Semanas de parciales (inicio/fin, separadas por coma). La encuesta de parciales se pide desde EXAM_LEAD_DAYS días antes y una sola vez por periodo.
EXAM_WEEKS=
EXAM_LEAD_DAYS=7
# Correo para los códigos de verificación (OBLIGATORIO en producción; usa una contraseña de aplicación, no la normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Límites (valores por defecto razonables)
LOGIN_MAX_FAILS=5                   # intentos fallidos por cuenta antes de bloquear 15 min (30, 60… si sigue)
LOGIN_IP_MAX_FAILS=40
POW_BITS=16                         # dificultad del captcha propio (16 ≈ 1 s en un celular)
# ───── Copias de seguridad automáticas cada 24 h (servicio backup) ─────
BACKUP_KEY=                         # base64 de 32 bytes (tools/gen_secrets.py). SIN ELLA NO SE PUEDEN RESTAURAR: guárdala también fuera del servidor
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Opcional: subir además cada copia a otro almacenamiento S3 (otro proveedor/región = copia fuera del servidor)
BACKUP_S3_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# ───── Solo Vercel / tareas programadas ─────
CRON_SECRET=                        # 32+ caracteres; protege /api/cron/* (ver DESPLIEGUE.md)
# ───── Solo producción (Caddy: HTTPS automático) ─────
DOMAIN=
ACME_EMAIL=
# Las keys de IA NO van aquí: están separadas en .env.chat (chat) y .env.etl (ETL).
