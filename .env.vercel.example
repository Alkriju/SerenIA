# Variables de entorno para VERCEL (Project → Settings → Environment Variables). NO subas este archivo con valores reales a GitHub: se pegan en el panel de Vercel.
# Secretos nuevos: python tools/gen_secrets.py   (JWT_SECRET, PSEUDO_KEY, BACKUP_KEY, CRON_SECRET)

# ── Aplicación ──
APP_ENV=production
BASE_URL=https://TU-PROYECTO.vercel.app        # o tu dominio propio; debe ser https
JWT_SECRET=
PSEUDO_KEY=
CRON_SECRET=
EMAIL_DOMAIN=uniminuto.edu.co
TERMS_VERSION=2026-11-16
ADMIN_EMAILS=
MAX_AUDIO_BYTES=3500000                        # Vercel limita el cuerpo de cada petición a 4,5 MB (el audio viaja en base64)
# ── Correo de códigos (obligatorio en producción). Gmail: contraseña de aplicación; o Brevo/Resend (planes gratis con SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── PostgreSQL: Neon (Connection string con "Pooled connection" activado: el host lleva -pooler) ──
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── MongoDB Atlas (Connect → Drivers → Python; usuario con permisos de lectura/escritura en la base "psico") ──
MONGO_URL=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── Datalake: Cloudflare R2 (R2 → Manage API tokens → Object Read & Write; crea antes el bucket) ──
S3_URL=https://ID_DE_CUENTA.r2.cloudflarestorage.com
S3_KEY=
S3_SECRET=
S3_BUCKET=serenia-lake
S3_REGION=auto

# ── Copias de seguridad (diarias, cifradas) ──
BACKUP_KEY=
BACKUP_KEEP_DAYS=14
# Recomendado: otro proveedor distinto del datalake (p. ej. un bucket gratis de Backblaze B2). Si lo dejas vacío, se guardan en backups/ del mismo bucket de R2.
BACKUP_S3_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1

# ── IA (las mismas variables de .env.chat y .env.etl; en Vercel van todas juntas en el mismo proyecto) ──
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_API_KEYS=
OPENAI_API_KEYS=
LLM_ORDER=gemini,openai,groq
MEMORY_LLM_ORDER=groq,openai,gemini
DEEPSEEK_API_KEYS=
QWEN_API_KEYS=
ETL_LLM_ORDER=deepseek,qwen
